# chronos — environment (all optional; the CLI reads these via the process env)

# --- LLM providers (OpenAI-compatible). Configure at least one. ---
DEEPSEEK_API_KEY=
# Optional second key: requests are round-robin balanced and fail over on
# authentication, rate-limit, network, and upstream server failures.
DEEPSEEK_API_KEY_2=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL_ID=glm-4-plus

# --- Platform work-source (scheduler mode only; real engagements use none) ---
# The platform is pluggable. "tsec" selects the built-in TSecBench adapter —
# just one adapter, not a hard binding. Add others in internal/platform.
PLATFORM_MODE=tsec
# TSecBench adapter config:
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=
# PLATFORM_URL=            # overrides BENCHMARK_BASE_URL if set

# --- Scheduler ---
MAX_CONCURRENT_CHALLENGES=3
CHALLENGE_TIME_LIMIT_SECONDS=1800
KILLCHAIN_TIME_LIMIT_SECONDS=2700
# TOTAL_BENCHMARK_BUDGET_SECONDS=0   # 0 = untracked; e.g. 21600 for a 360-min title
MIN_REMAINING_SECONDS_TO_SPAWN=300
MAX_CHALLENGE_ATTEMPTS=3
DEFER_RETRY_COOLDOWN_SECONDS=120
AUTO_RESUME_IDLE_SECONDS=240

# --- Executor / state ---
MAX_BUMPS=20
MAX_DELEGATE_DEPTH=1
MAX_DELEGATE_CHILDREN=3
MAX_DELEGATE_STEPS=20
# Model-generated Python runs with host permissions. Keep disabled unless the
# process is already isolated by an OS/container sandbox.
ALLOW_LOCAL_EXEC=false
TARGET_INSECURE_TLS=false
PLATFORM_INSECURE_TLS=false
CHRONOS_STATE_DIR=.chronos-state
