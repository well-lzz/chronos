# 由平台自动注入；不要填写或上传真实值
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=<platform-injected>

# 在平台运行变量中填写；不要提交真实密钥
DEEPSEEK_API_KEY=<runtime-secret>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Dockerfile 已设置的托管默认值
TSECBENCH_HOSTED=true
MAX_CONCURRENT_CHALLENGES=3
TOTAL_BENCHMARK_BUDGET_SECONDS=28200
ALLOW_LOCAL_EXEC=true
