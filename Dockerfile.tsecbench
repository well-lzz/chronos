# syntax=docker/dockerfile:1

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath -ldflags="-s -w" -o /out/chronos ./cmd/chronos

FROM python:3.13-slim-bookworm
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && npm install -g @playwright/mcp@0.0.83 \
    && npx --yes playwright@1.64.0-alpha-1790635538000 install --with-deps chromium \
    && chmod -R a+rX /opt/ms-playwright \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system chronos \
    && useradd --system --gid chronos --home-dir /state --create-home chronos
COPY --from=build /out/chronos /usr/local/bin/chronos
RUN chmod 0755 /usr/local/bin/chronos && chown -R chronos:chronos /state

ENV HOME=/state \
    CHRONOS_STATE_DIR=/state \
    PLATFORM_MODE=tsec \
    TSECBENCH_HOSTED=true \
    MAX_CONCURRENT_CHALLENGES=3 \
    CHALLENGE_TIME_LIMIT_SECONDS=1800 \
    KILLCHAIN_TIME_LIMIT_SECONDS=2700 \
    TOTAL_BENCHMARK_BUDGET_SECONDS=28200 \
    MIN_REMAINING_SECONDS_TO_SPAWN=300 \
    MAX_CHALLENGE_ATTEMPTS=3 \
    DEFER_RETRY_COOLDOWN_SECONDS=120 \
    AUTO_RESUME_IDLE_SECONDS=240 \
    ALLOW_LOCAL_EXEC=true \
    CHRONOS_PLAYWRIGHT_CLI=/usr/local/lib/node_modules/@playwright/mcp/cli.js \
    CHRONOS_PLAYWRIGHT_NO_SANDBOX=true

USER chronos
WORKDIR /state
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/chronos"]
